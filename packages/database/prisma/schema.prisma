generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  owner
  manager
  agent
}

enum TicketStatus {
  new
  open
  pending
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TicketActivityType {
  created
  status_changed
  priority_changed
  assigned
  reply_added
  note_added
  tag_added
  tag_removed
  triage_suggested
  triage_reviewed
  knowledge_searched
}

enum TicketQueue {
  billing
  account
  technical
  sales
}

enum TriageReviewStatus {
  pending
  accepted
  overridden
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions                   Session[]
  accounts                   Account[]
  memberships                Membership[]
  ticketMessages             TicketMessage[]
  internalNotes              InternalNote[]
  createdAssignments         Assignment[]                 @relation("AssignmentActor")
  ticketActivities           TicketActivity[]
  createdKnowledgeDocuments  KnowledgeDocument[]          @relation("KnowledgeDocumentCreator")
  knowledgeSearches          KnowledgeSearch[]             @relation("KnowledgeSearchActor")
  reviewedTriageSuggestions ClassificationSuggestion[]    @relation("TriageReviewer")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  customers   Customer[]
  tickets     Ticket[]
  tags        Tag[]
  activities  TicketActivity[]
  knowledgeDocuments        KnowledgeDocument[]
  knowledgeSearches         KnowledgeSearch[]
  classificationSuggestions ClassificationSuggestion[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole   @default(agent)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    Assignment[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, role])
  @@map("memberships")
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets        Ticket[]

  @@unique([id, organizationId])
  @@unique([organizationId, email])
  @@index([organizationId, name])
  @@map("customers")
}

model Ticket {
  id                String                       @id @default(cuid())
  organizationId    String
  customerId        String
  subject           String
  description       String                       @db.Text
  status            TicketStatus                 @default(new)
  priority          TicketPriority               @default(normal)
  queue             TicketQueue?
  slaTargetAt       DateTime?
  resolvedAt        DateTime?
  version           Int                          @default(0)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer                     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  messages          TicketMessage[]
  internalNotes     InternalNote[]
  assignments       Assignment[]
  tags              TicketTag[]
  activities        TicketActivity[]
  knowledgeSearches KnowledgeSearch[]
  triageSuggestions ClassificationSuggestion[]

  @@unique([id, organizationId])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, priority, updatedAt])
  @@index([organizationId, createdAt])
  @@map("tickets")
}

model TicketMessage {
  id             String   @id @default(cuid())
  organizationId String
  ticketId       String
  authorUserId   String?
  body           String   @db.Text
  createdAt      DateTime @default(now())
  ticket         Ticket   @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author         User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, createdAt])
  @@map("ticket_messages")
}

model InternalNote {
  id             String   @id @default(cuid())
  organizationId String
  ticketId       String
  authorUserId   String?
  body           String   @db.Text
  createdAt      DateTime @default(now())
  ticket         Ticket   @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  author         User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, createdAt])
  @@map("internal_notes")
}

model Assignment {
  id                  String     @id @default(cuid())
  organizationId      String
  ticketId            String
  membershipId        String
  actorUserId         String?
  assignedAt          DateTime   @default(now())
  endedAt             DateTime?
  ticket              Ticket     @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  membership          Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actor               User?      @relation("AssignmentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, endedAt])
  @@index([organizationId, membershipId, endedAt])
  @@map("assignments")
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tickets        TicketTag[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@map("tags")
}

model TicketTag {
  organizationId String
  ticketId       String
  tagId          String
  createdAt      DateTime     @default(now())
  ticket         Ticket       @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([organizationId, tagId])
  @@map("ticket_tags")
}

model TicketActivity {
  id             String             @id @default(cuid())
  organizationId String
  ticketId       String
  actorUserId    String?
  type           TicketActivityType
  summary        String
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket             @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor          User?              @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, ticketId, createdAt])
  @@map("ticket_activities")
}


model KnowledgeDocument {
  id             String       @id @default(cuid())
  organizationId String
  createdByUserId String?
  title          String
  content        String       @db.Text
  contentHash    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User?        @relation("KnowledgeDocumentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  chunks         KnowledgeChunk[]

  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@index([organizationId, title])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  ordinal        Int
  content        String   @db.Text
  startLine      Int
  endLine        Int
  createdAt      DateTime @default(now())
  document       KnowledgeDocument @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  citations      KnowledgeCitation[]

  @@unique([id, organizationId])
  @@unique([documentId, ordinal])
  @@index([organizationId, documentId])
  @@map("knowledge_chunks")
}

model KnowledgeSearch {
  id             String       @id @default(cuid())
  organizationId String
  ticketId       String
  actorUserId    String?
  queryHash      String
  rankerVersion  String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket         Ticket       @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  actor          User?        @relation("KnowledgeSearchActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  citations      KnowledgeCitation[]

  @@unique([id, organizationId])
  @@index([organizationId, ticketId, createdAt])
  @@map("knowledge_searches")
}

model KnowledgeCitation {
  id             String          @id @default(cuid())
  organizationId String
  searchId       String
  chunkId        String
  rank           Int
  score          Float
  titleSnapshot  String
  excerpt        String          @db.Text
  startLine      Int
  endLine        Int
  createdAt      DateTime        @default(now())
  search         KnowledgeSearch @relation(fields: [searchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  chunk          KnowledgeChunk  @relation(fields: [chunkId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([searchId, rank])
  @@index([organizationId, chunkId])
  @@map("knowledge_citations")
}

model ClassificationSuggestion {
  id                String            @id @default(cuid())
  organizationId    String
  ticketId          String
  suggestedQueue    TicketQueue?
  scores            Json
  modelVersion      String
  abstained         Boolean           @default(false)
  abstentionReason  String?
  reviewStatus      TriageReviewStatus @default(pending)
  reviewedQueue     TicketQueue?
  reviewReason      String?
  reviewerUserId    String?
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ticket            Ticket            @relation(fields: [ticketId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reviewer          User?             @relation("TriageReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@unique([id, organizationId])
  @@index([organizationId, ticketId, createdAt])
  @@index([organizationId, reviewStatus, createdAt])
  @@map("classification_suggestions")
}
