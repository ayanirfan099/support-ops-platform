{
  "name": "supportops",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @supportops/web dev",
    "build": "pnpm --filter @supportops/web build",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @supportops/contracts typecheck && pnpm --filter @supportops/ui typecheck && pnpm --filter @supportops/database typecheck && pnpm --filter @supportops/web typecheck",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "pnpm --filter @supportops/database prisma:generate",
    "db:migrate": "pnpm --filter @supportops/database prisma:migrate",
    "db:seed": "pnpm --filter @supportops/web seed"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "dotenv": "16.5.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
